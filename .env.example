# Copy to .env.local and fill in. Never commit real values.

# ── Site lock ────────────────────────────────────────────────────────
# Password-gates the whole site while pre-launch.
SITE_LOCKED=true
SITE_PASSWORD=

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, bypasses Row Level Security.
# Required to write and read order rows. Never expose to the browser and
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ────────────────────────────────────────────────────────────
# Comma-separated allowlist of emails that may view /admin/orders.
# Empty means nobody has admin access.
ADMIN_EMAILS=

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="The Pure Pep <support@thepurepep.com>"
NEXT_PUBLIC_SITE_URL=https://thepurepep.com

# ── Payments (NMI) ───────────────────────────────────────────────────
# Gateway origin. https://sandbox.nmi.com for testing;
# https://secure.nmi.com (or your ISO's branded origin) for live.
NEXT_PUBLIC_NMI_GATEWAY_HOST=https://secure.nmi.com

# Public tokenization key — safe in the browser, used by CollectJS.
NEXT_PUBLIC_NMI_TOKENIZATION_KEY=

# Private gateway key — SERVER ONLY. Until this is set, checkout runs in
# mock mode (no money moves) and refuses to run at all in production.
NMI_SECURITY_KEY=

# Escape hatch to allow mock approvals in a production build. Leave unset.
# Turning this on means customers see "order confirmed" without paying.
# ALLOW_MOCK_CHECKOUT=true
