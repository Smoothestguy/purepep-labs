# Copy to .env.local and fill in. Never commit real values.

# ── Site lock ────────────────────────────────────────────────────────
# Password-gates the whole site while pre-launch.
SITE_LOCKED=true
SITE_PASSWORD=

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, bypasses Row Level Security.
# Required to write and read order rows. Never expose to the browser and
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ────────────────────────────────────────────────────────────
# Comma-separated allowlist of emails that may view /admin/orders.
# Empty means nobody has admin access.
ADMIN_EMAILS=

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="The Pure Pep <support@thepurepep.com>"
NEXT_PUBLIC_SITE_URL=https://thepurepep.com

# ── Payments: which processor handles cards ──────────────────────────
# "stripe" (default) or "nmi". NMI is kept wired up but switched off, so
# card processing can be moved back with an env change and a redeploy.
CARD_PROCESSOR=stripe

# ── Payments (Stripe) ────────────────────────────────────────────────
# Secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_. Until this is
# set, the card option is hidden at checkout rather than failing on submit.
# Use sk_test_… while testing; nothing here fakes an approval, so a test
# key is the only safe way to exercise the flow.
STRIPE_SECRET_KEY=

# Signing secret for POST /api/webhooks/stripe. Without it the endpoint
# refuses deliveries — the signature is the only thing stopping anyone
# from marking their own orders paid.
#
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#        prints a whsec_… to use here.
# Live:  Stripe Dashboard → Developers → Webhooks → add endpoint at
#        https://thepurepep.com/api/webhooks/stripe, subscribed to
#        checkout.session.completed, checkout.session.expired,
#        checkout.session.async_payment_succeeded and
#        checkout.session.async_payment_failed.
STRIPE_WEBHOOK_SECRET=

# Stripe's return URLs are built from NEXT_PUBLIC_SITE_URL (set above).
# If it is unset, lib/site-url falls back to Vercel's own system variables
# — VERCEL_PROJECT_PRODUCTION_URL on production, VERCEL_URL on preview — so
# preview deployments return to themselves rather than to the live site.
# The request's Host header is only trusted in development, since it is
# attacker-controlled. Set NEXT_PUBLIC_SITE_URL anyway: it pins the
# canonical domain instead of whichever one Vercel happens to pick.

# ── Payments (NMI — parked, set CARD_PROCESSOR=nmi to use) ───────────
# Gateway origin. https://sandbox.nmi.com for testing;
# https://secure.nmi.com (or your ISO's branded origin) for live.
NEXT_PUBLIC_NMI_GATEWAY_HOST=https://secure.nmi.com

# Public tokenization key — safe in the browser, used by CollectJS.
NEXT_PUBLIC_NMI_TOKENIZATION_KEY=

# Private gateway key — SERVER ONLY. Until this is set, checkout runs in
# mock mode (no money moves) and refuses to run at all in production.
NMI_SECURITY_KEY=

# Escape hatch to allow mock approvals in a production build. Leave unset.
# Turning this on means customers see "order confirmed" without paying.
# ALLOW_MOCK_CHECKOUT=true

# ── Manual payment methods ───────────────────────────────────────────
# Which non-card methods to offer at checkout. Comma-separated; empty
# means card only. Valid: bank_transfer, crypto
NEXT_PUBLIC_PAYMENT_METHODS=

# Shown to the customer and emailed after they order. Server-only — these
# never reach the browser bundle. Use \n for line breaks.
BANK_TRANSFER_INSTRUCTIONS=
CRYPTO_INSTRUCTIONS=
